# Entorno: dev | prod
ENV=dev

# Cadena de conexión PostgreSQL (Supabase: Project Settings > Database > Connection string > Transaction pooler).
# Sirve cualquier PostgreSQL: Supabase, Neon, RDS... basta cambiar esta variable.
# Local sin Postgres: sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db

# Secreto para firmar los tokens (genera uno largo: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRE_MIN=480

# Super admin inicial (se crea con: python -m app.seed)
SUPERADMIN_EMAIL=admin@tuplataforma.com
SUPERADMIN_PASSWORD=cambia-esta-clave-ya

# Orígenes permitidos (separados por coma). El front usa un proxy, así que normalmente no hace falta.
CORS_ORIGINS=http://localhost:3000
